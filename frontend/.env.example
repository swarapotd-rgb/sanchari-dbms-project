# Copy this file to .env.local. .env.local is in .gitignore, so the real
# values never reach GitHub. Nothing below is hard-coded in the source.

# PostgreSQL: the sanchari-db container from the main README.
DATABASE_URL=postgres://postgres:sanchari_dev@localhost:5432/sanchari

# MongoDB: the sanchari-mongo container. Optional - without it the app
# still runs and shows ratings, just not the written review text.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sanchari

# Any long random string (32+ characters). It signs the login cookie.
# PowerShell:  [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-characters
